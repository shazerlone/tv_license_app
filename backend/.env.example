# ─────────────────────────────────────────────────────────────
# Millimore backend — environment
# Copy to `.env` and fill in. Every secret from Section 7 of
# docs/BACKEND_CONTRACT.md is listed here.
# ─────────────────────────────────────────────────────────────

# --- Core / server ---
NODE_ENV=development
PORT=3000
# Demo/seed control. SEED_DEMO=true seeds fake creators/traders/posts/wallets for
# dev. Leave UNSET/false in production. A real admin is created from the two vars
# below (needed to log into the admin dashboard in prod). Use `npm run db:wipe-demo`
# to remove demo rows already present in a live DB.
SEED_DEMO=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Deposits (crypto) ---
# HARD prod safety: the wallet is only auto-credited when DEPOSIT_AUTO_CONFIRM=true
# (dev/test). In production leave it false — deposits are credited only by the
# processor webhook (below) or admin approval. With no processor configured and
# auto-confirm off, deposit creation fails closed (no fake addresses are issued).
DEPOSIT_AUTO_CONFIRM=false
CRYPTO_DEPOSIT_PROVIDER=          # nowpayments  (leave empty = crypto deposits disabled / fail-closed)
# Public base URL of THIS API, used to build the processor's IPN callback URL
# (e.g. https://api.millimore.app). Needed so the processor can call us back.
PUBLIC_BASE_URL=
# NOWPayments (https://nowpayments.io) — Dashboard → Settings → API keys / IPN.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Optional: override the asset→network map, e.g. {"USDT":"usdterc20"}.
NOWPAYMENTS_ASSET_MAP=
# Only for a CUSTOM processor (when CRYPTO_DEPOSIT_PROVIDER is empty): generic
# HMAC-SHA256 secret verified over the raw webhook body (header x-signature).
CRYPTO_WEBHOOK_SECRET=

# --- Per-user deposit addresses (address-based provider, e.g. Tatum Gas Pump) ---
# Issues one USDT address per user per network (tron/ethereum/bsc) after KYC and
# credits the wallet on a signed deposit webhook. Disabled unless set.
#   mock  = dev/testnet only (fake addresses; ignored in production)
#   tatum = Phase 2 (real Gas Pump; not wired yet)
CRYPTO_ADDRESS_PROVIDER=          # mock (dev) | tatum
CRYPTO_ADDRESS_WEBHOOK_SECRET=   # mock provider only: verifies POST /webhooks/deposits/chain
# Tatum (https://tatum.io) — CRYPTO_ADDRESS_PROVIDER=tatum. The API key's own
# environment decides testnet vs mainnet; keep separate testnet/mainnet keys.
TATUM_API_KEY=
TATUM_HMAC_SECRET=               # from Tatum notification settings; verifies webhook (x-payload-hash)
TATUM_NETWORK=testnet            # informational: testnet | mainnet
# Master wallet PUBLIC keys (xpub) — private keys/mnemonic stay OFFLINE with you.
# ETH xpub is reused for BSC unless TATUM_XPUB_BSC is set. Generate a wallet per
# chain in Tatum and paste ONLY the xpub here (never the mnemonic).
TATUM_XPUB_TRON=
TATUM_XPUB_ETH=
TATUM_XPUB_BSC=
# TronGrid (TRON reconciliation + balance reads). Optional key lifts rate limits;
# TRON_RPC_BASE overrides the indexer (default: nile.trongrid.io testnet / api.trongrid.io mainnet).
TRONGRID_API_KEY=
TRON_RPC_BASE=
#
# --- Auto-sweep / consolidation (Gas Pump + KMS) — OFF until fully set ---
# Sweeps credited USDT off each user's deposit address into your master wallet.
# Non-custodial: signing is delegated to a Tatum KMS process you run (signatureId);
# the mnemonic NEVER touches this server. Requires Gas Pump addresses.
SWEEP_ENABLED=false               # master switch; keep false until tested on testnet
SWEEP_MODE=batch                  # batch (scheduled, cheaper) | instant (per deposit)
SWEEP_BATCH_INTERVAL_MS=900000    # batch mode: how often to consolidate (default 15 min; floor 30s)
CRYPTO_ADDRESS_MODE=hd            # hd (plain xpub) | gaspump (required for sweep)
TATUM_GP_MASTER=                  # Gas Pump master address (owns the deposit addresses); you hold its key in KMS
TATUM_GP_MASTER_TRON=             # optional per-network overrides of TATUM_GP_MASTER
TATUM_GP_MASTER_ETH=
TATUM_GP_MASTER_BSC=
TATUM_KMS_SIGNATURE_ID=           # KMS-managed wallet id that signs sweeps (from tatum-kms)
# Per-network sweep floors — only sweep when the balance is worth the gas. Defaults:
# TRON 1 (near-free with Energy), ETHEREUM 50 (gas is pricey), BSC 5. Override one
# network below, or all with SWEEP_MIN_USDT.
SWEEP_MIN_USDT=                   # optional global floor (applies to all networks)
SWEEP_MIN_USDT_TRON=
SWEEP_MIN_USDT_ETHEREUM=
SWEEP_MIN_USDT_BSC=
TATUM_USDT_CONTRACT_TRON=         # override USDT contract per network (testnet differs)
TATUM_USDT_CONTRACT_ETHEREUM=
TATUM_USDT_CONTRACT_BSC=
TATUM_TRON_FEE_LIMIT=100          # TRON sweep fee limit (TRX)
TATUM_SWEEP_PATH=                 # advanced: override Tatum custodial-transfer endpoint path
# Public base path the API is served under (matches contract Base URL /v1)
API_PREFIX=v1
# Comma-separated allowed CORS origins (admin dashboard, app dev, etc.)
CORS_ORIGINS=http://localhost:3001,http://localhost:8080

# --- Section 7: DATABASE_URL ---
DATABASE_URL=postgresql://millimore:millimore@localhost:5432/millimore?schema=public

# --- Section 7: JWT_SECRET ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Encryption key for write-only credentials (broker/investor passwords, tokens).
# 32-byte key, base64 or hex. Generate: `openssl rand -base64 32`
CREDENTIAL_ENCRYPTION_KEY=change-me-32-byte-base64-key

# --- Redis (REQUIRED to run >1 instance) ---
# When set, realtime events + prices fan out across all instances (AWS
# ElastiCache). Leave UNSET to run a single instance (local dev / one task).
REDIS_URL=redis://localhost:6379

# --- Push (FCM HTTP v1) — real device push; token registry works without it ---
# Provide the Firebase service-account JSON (raw or base64). The legacy
# FCM_SERVER_KEY is NOT used (Google deprecated it).
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_B64=

# --- Transactional email (password reset, security alerts, receipts) ---
# MAIL_PROVIDER=console (default) logs emails and surfaces the reset token as
# `devToken`; MAIL_PROVIDER=smtp sends for real (works with Amazon SES SMTP,
# SendGrid, Mailgun — paste their SMTP host/user/pass).
MAIL_PROVIDER=console           # console | smtp
MAIL_FROM=Millimore <no-reply@millimore.app>
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=false          # true for port 465
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
# Where the app opens the reset link (deep link or web page): appends ?token=...
MAIL_RESET_URL_BASE=https://millimore.app/reset
# How long a password-reset token is valid.
PASSWORD_RESET_TTL_MINUTES=30

# --- Section 7: OTP_PROVIDER_KEY (Twilio / MSG91) ---
# Leave OTP_PROVIDER_KEY unset in development: OTP codes are then logged to the
# server console AND returned in the response as `devCode` for easy integration.
OTP_PROVIDER=console            # console | twilio | msg91
OTP_PROVIDER_KEY=
OTP_SENDER_ID=MLMORE            # sender id / from-number
OTP_CODE_TTL_SECONDS=300
OTP_CODE_LENGTH=6

# --- Section 7: CLOUDFLARE_STREAM_TOKEN (live inputs + simulcast outputs) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=

# --- Section 7: YOUTUBE_OAUTH_CLIENT_ID / SECRET (live chat + simulcast auth) ---
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:3000/v1/broadcasts/oauth/youtube/callback

# --- Section 7: FACEBOOK_APP_ID / SECRET ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Section 7: BROKER_BRIDGE_URL (MT4/MT5 gateway — prices + orders + investor-pw verify) ---
# MetaApi (metaapi.cloud) token or a custom EA bridge base URL.
BROKER_BRIDGE_URL=
METAAPI_TOKEN=

# --- Section 7: MARKET_DATA_PROVIDER (live quotes for GET /prices + WS prices) ---
# Anchors the price engine to real quotes; unset/none = fully synthetic (dev).
# Values: twelvedata | finnhub | auto (pick whichever key is set) | none.
# twelvedata batches every symbol in one request (best fit); finnhub is one
# request per symbol. Free tiers are rate-limited, so we refresh every ~15s and
# interpolate between refreshes.
MARKET_DATA_PROVIDER=
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=
# Credit control (providers bill 1 credit per symbol per request):
#  - Only symbols in use are fetched (open positions, active alerts, or a pair
#    viewed via GET /prices in the last MARKET_ACTIVE_WINDOW_MS). Idle → 0 calls.
#  - Rough daily credits ≈ (avg symbols in use) × (86400 / refresh-seconds).
#  - MARKET_DAILY_CREDIT_BUDGET is a hard cap: once reached, the engine holds the
#    last real quotes (still ticks synthetically) until the next UTC day. This is
#    what prevents ever overrunning a metered plan again.
MARKET_REFRESH_MS=60000            # how often to pull real quotes (raise to spend less)
MARKET_ACTIVE_WINDOW_MS=180000     # how long a viewed symbol stays "in use"
MARKET_DAILY_CREDIT_BUDGET=750     # hard daily cap (Twelve Data free tier = 800/day)

# --- Section 7: STORAGE_BUCKET (statements, photos — S3/GCS) ---
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=

# --- Social login verification ---
APPLE_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID=
