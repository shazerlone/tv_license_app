# Base URL of the Millimore backend API (must include the /v1 prefix).
#
# LEAVE UNSET for the single-origin deploy (the backend serves this UI at its
# own root, so the app calls the relative `/v1` on the same origin — the default).
#
# Set it ONLY for split local dev, where the admin (`npm run dev`, :3001) and the
# API (:3000) are different origins:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/v1
