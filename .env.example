# Copy this file to ".env" and paste your key after the = sign.
#   cp .env.example .env
# The real .env file is gitignored — it never gets committed or shared.
# NEVER paste your key into a chat, a screenshot, or a commit.

GOOGLE_PLACES_API_KEY=paste-your-key-here

# --- optional tuning (safe defaults are built in) ---
# SITEGAP_COST_PER_QUERY=0.032   # USD/query, only used to estimate spend
# SITEGAP_PORT=5001              # web dashboard port
